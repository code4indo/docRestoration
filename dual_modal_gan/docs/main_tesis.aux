\newlabel{tab:A_generator_arch}{{VI.1}{180}{Arsitektur Generator U-Net Enhanced. Spesifikasi detail lima tahap encoder (progressive downsampling dari $128 \times 1024$ ke $4 \times 32$), bottleneck MSFP dengan konvolusi terdilasi, dan lima tahap decoder dengan attention gates. Setiap tahap mengintegrasikan RDB+CBAM untuk ekstraksi fitur hierarkis dan atensi adaptif. Total parameter: 21.8M.\relax }{table.caption.74}{}}
\@writefile{toc}{\contentsline {section}{LAMPIRAN B ARSITEKTUR DISKRIMINATOR DUAL-MODAL ENHANCED}{181}{table.caption.74}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {VI.1}{\ignorespaces Arsitektur Diskriminator Dual-Modal Enhanced. Spesifikasi detail tiga cabang (Citra CNN, Teks BiLSTM, Fusi \textit  {Cross-Modal}). Cabang citra memproses fitur visual melalui 4 \textit  {DownBlocks} dengan \textit  {spatial attention}, cabang teks memproses sekuens karakter melalui embedding + BiLSTM + \textit  {self-attention}. \textit  {Cross-modal fusion} menghasilkan klasifikasi \textit  {real}/\textit  {fake}. Total: 17.4M parameter.\relax }}{181}{table.caption.75}\protected@file@percent }
\newlabel{tab:B_discriminator_arch}{{VI.1}{181}{Arsitektur Diskriminator Dual-Modal Enhanced. Spesifikasi detail tiga cabang (Citra CNN, Teks BiLSTM, Fusi \textit {Cross-Modal}). Cabang citra memproses fitur visual melalui 4 \textit {DownBlocks} dengan \textit {spatial attention}, cabang teks memproses sekuens karakter melalui embedding + BiLSTM + \textit {self-attention}. \textit {Cross-modal fusion} menghasilkan klasifikasi \textit {real}/\textit {fake}. Total: 17.4M parameter.\relax }{table.caption.75}{}}
