\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Trajektori metrik validasi dengan interval kepercayaan 95\% selama 50 \textit  {epoch} ($n$=710): (a) PSNR mencapai 30.91±0.42 dB, (b) SSIM mencapai 0.987±0.001, (c) CER mendekati \textit  {baseline} citra bersih, (d) WER menunjukkan pola serupa. Model terbaik (\textit  {epoch} 44, bintang merah) dipilih berdasarkan kriteria gabungan PSNR-CER. Interval kepercayaan sempit mengindikasikan kinerja konsisten. Evaluasi akhir pada \textit  {set} uji: PSNR 30.74 dB, SSIM 0.987, CER 34.9\% (Tabel~\ref  {table:synthetic-results}).\relax }}{120}{figure.caption.2}\protected@file@percent }
\newlabel{fig:validation-metrics-trajectory}{{1}{120}{Trajektori metrik validasi dengan interval kepercayaan 95\% selama 50 \textit {epoch} ($n$=710): (a) PSNR mencapai 30.91±0.42 dB, (b) SSIM mencapai 0.987±0.001, (c) CER mendekati \textit {baseline} citra bersih, (d) WER menunjukkan pola serupa. Model terbaik (\textit {epoch} 44, bintang merah) dipilih berdasarkan kriteria gabungan PSNR-CER. Interval kepercayaan sempit mengindikasikan kinerja konsisten. Evaluasi akhir pada \textit {set} uji: PSNR 30.74 dB, SSIM 0.987, CER 34.9\% (Tabel~\ref {table:synthetic-results}).\relax }{figure.caption.2}{}}
