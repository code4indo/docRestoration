\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Perbandingan Trajektori \textit  {Loss} antara \textit  {Frozen Recognizer} dan \textit  {Joint Training}\relax }}{130}{table.caption.7}\protected@file@percent }
\newlabel{tab:frozen-vs-joint-loss}{{5}{130}{Perbandingan Trajektori \textit {Loss} antara \textit {Frozen Recognizer} dan \textit {Joint Training}\relax }{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Perbandingan trajektori \textit  {loss} antara \textit  {frozen recognizer} dan \textit  {joint training} selama 20 \textit  {epoch}. (a) Generator \textit  {loss} menunjukkan fluktuasi frozen akibat \textit  {curriculum learning} ($\mu $=114.2, $\sigma $=136.6) versus osilasi ekstrem joint (rentang 47--408, $\mu $=125.1, $\sigma $=61.3). (b) Discriminator \textit  {loss} menunjukkan keseimbangan frozen (1.39 $\pm $ 0.07) versus \textit  {mode collapse} pada joint (0.018 $\pm $ 0.06). (c) Recognizer \textit  {loss} (CTC) menunjukkan pembelajaran adaptif frozen (205.4 $\pm $ 194.1) versus ketidakstabilan joint (119.4 $\pm $ 61.6).\relax }}{131}{figure.caption.8}\protected@file@percent }
\newlabel{fig:loss-trajectory}{{3}{131}{Perbandingan trajektori \textit {loss} antara \textit {frozen recognizer} dan \textit {joint training} selama 20 \textit {epoch}. (a) Generator \textit {loss} menunjukkan fluktuasi frozen akibat \textit {curriculum learning} ($\mu $=114.2, $\sigma $=136.6) versus osilasi ekstrem joint (rentang 47--408, $\mu $=125.1, $\sigma $=61.3). (b) Discriminator \textit {loss} menunjukkan keseimbangan frozen (1.39 $\pm $ 0.07) versus \textit {mode collapse} pada joint (0.018 $\pm $ 0.06). (c) Recognizer \textit {loss} (CTC) menunjukkan pembelajaran adaptif frozen (205.4 $\pm $ 194.1) versus ketidakstabilan joint (119.4 $\pm $ 61.6).\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {paragraph}{2. Performa Keterbacaan Teks yang Dihasilkan}{132}{figure.caption.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Perbandingan Metrik Keterbacaan Teks antara \textit  {Frozen Recognizer} dan \textit  {Joint Training}\relax }}{132}{table.caption.9}\protected@file@percent }
\newlabel{tab:frozen-vs-joint-cer}{{6}{132}{Perbandingan Metrik Keterbacaan Teks antara \textit {Frozen Recognizer} dan \textit {Joint Training}\relax }{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Perbandingan Character Error Rate (CER) antara \textit  {frozen recognizer} dan \textit  {joint training} selama 20 \textit  {epoch}. \textit  {Frozen recognizer} mempertahankan CER relatif stabil di 31.63\% (degradasi +5.06\% dari \textit  {baseline} 26.57\%), sementara \textit  {joint training} mengalami \textit  {kelupaan katastropik} ekstrem dengan CER konstan 100.00\% (degradasi +73.43\%), mengindikasikan kehilangan total kemampuan pengenalan karakter.\relax }}{133}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cer-comparison}{{4}{133}{Perbandingan Character Error Rate (CER) antara \textit {frozen recognizer} dan \textit {joint training} selama 20 \textit {epoch}. \textit {Frozen recognizer} mempertahankan CER relatif stabil di 31.63\% (degradasi +5.06\% dari \textit {baseline} 26.57\%), sementara \textit {joint training} mengalami \textit {kelupaan katastropik} ekstrem dengan CER konstan 100.00\% (degradasi +73.43\%), mengindikasikan kehilangan total kemampuan pengenalan karakter.\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Perbandingan kualitas visual (PSNR) antara \textit  {frozen recognizer} dan \textit  {joint training}. \textit  {Frozen recognizer} mempertahankan PSNR yang konsisten (23.09 $\pm $ 3.88 dB) yang berada dalam zona kualitas wajar, sementara \textit  {joint training} menghasilkan PSNR yang rendah (17.70 $\pm $ 5.21 dB), menunjukkan degradasi kualitas visual sebesar 5.39 dB. Meskipun PSNR frozen tidak mencapai target ideal (>28 dB) dalam 20 \textit  {epoch} ablasi ini, perbedaan signifikan dengan \textit  {joint training} tetap mengonfirmasi keunggulan performa pendekatan frozen.\relax }}{134}{figure.caption.11}\protected@file@percent }
\newlabel{fig:psnr-comparison}{{5}{134}{Perbandingan kualitas visual (PSNR) antara \textit {frozen recognizer} dan \textit {joint training}. \textit {Frozen recognizer} mempertahankan PSNR yang konsisten (23.09 $\pm $ 3.88 dB) yang berada dalam zona kualitas wajar, sementara \textit {joint training} menghasilkan PSNR yang rendah (17.70 $\pm $ 5.21 dB), menunjukkan degradasi kualitas visual sebesar 5.39 dB. Meskipun PSNR frozen tidak mencapai target ideal (>28 dB) dalam 20 \textit {epoch} ablasi ini, perbedaan signifikan dengan \textit {joint training} tetap mengonfirmasi keunggulan performa pendekatan frozen.\relax }{figure.caption.11}{}}
\@writefile{toc}{\contentsline {paragraph}{3. Efisiensi Komputasi dalam Proses Optimisasi}{135}{figure.caption.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Perbandingan Efisiensi Komputasi antara \textit  {Frozen Recognizer} dan \textit  {Joint Training}\relax }}{135}{table.caption.12}\protected@file@percent }
\newlabel{tab:frozen-vs-joint-efficiency}{{7}{135}{Perbandingan Efisiensi Komputasi antara \textit {Frozen Recognizer} dan \textit {Joint Training}\relax }{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Perbandingan efisiensi komputasi antara \textit  {frozen recognizer} dan \textit  {joint training}. (a) Waktu pelatihan per \textit  {epoch}: \textit  {frozen} 67.4 $\pm $ 0.7 detik (\textit  {frozen}: training only, \textit  {joint}: training + validasi), \textit  {joint} 68.1 $\pm $ 1.5 detik (dari analisis \textit  {timestamp}). (b) Penggunaan memori GPU: hampir identik ($\sim $13.6 GB), pembekuan \textit  {recognizer} tidak memberikan keuntungan memori signifikan. (c) Jumlah parameter \textit  {trainable}: \textit  {frozen} 61.6\% lebih sedikit (17.4M vs $\sim $45.3M), berkontribusi pada stabilitas pelatihan dan pencegahan \textit  {kelupaan katastropik}.\relax }}{136}{figure.caption.13}\protected@file@percent }
\newlabel{fig:efficiency-comparison}{{6}{136}{Perbandingan efisiensi komputasi antara \textit {frozen recognizer} dan \textit {joint training}. (a) Waktu pelatihan per \textit {epoch}: \textit {frozen} 67.4 $\pm $ 0.7 detik (\textit {frozen}: training only, \textit {joint}: training + validasi), \textit {joint} 68.1 $\pm $ 1.5 detik (dari analisis \textit {timestamp}). (b) Penggunaan memori GPU: hampir identik ($\sim $13.6 GB), pembekuan \textit {recognizer} tidak memberikan keuntungan memori signifikan. (c) Jumlah parameter \textit {trainable}: \textit {frozen} 61.6\% lebih sedikit (17.4M vs $\sim $45.3M), berkontribusi pada stabilitas pelatihan dan pencegahan \textit {kelupaan katastropik}.\relax }{figure.caption.13}{}}
\@writefile{toc}{\contentsline {paragraph}{4. Ringkasan Temuan Kontribusi Frozen Recognizer}{136}{figure.caption.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Perbandingan multidimensi antara \textit  {frozen recognizer} dan \textit  {joint training} menggunakan diagram radar. Lima dimensi evaluasi mencakup: keterbacaan teks (CER), kualitas visual (PSNR), pencegahan \textit  {kelupaan katastropik}, efisiensi waktu, dan efisiensi memori. \textit  {Frozen recognizer} (biru) menunjukkan dominasi jelas di keterbacaan (CER 31.63\% vs 100\%) dan kualitas visual (PSNR 23.09 vs 17.70 dB), sementara \textit  {joint training} (merah) menunjukkan kegagalan total di preservasi kemampuan HTR. Efisiensi komputasi sebanding antara kedua pendekatan. Perlu dicatat bahwa data ini berasal dari ablasi 20 \textit  {epoch}, sehingga metrik visual belum optimal dibanding \textit  {production training}.\relax }}{138}{figure.caption.14}\protected@file@percent }
\newlabel{fig:radar-comparison}{{7}{138}{Perbandingan multidimensi antara \textit {frozen recognizer} dan \textit {joint training} menggunakan diagram radar. Lima dimensi evaluasi mencakup: keterbacaan teks (CER), kualitas visual (PSNR), pencegahan \textit {kelupaan katastropik}, efisiensi waktu, dan efisiensi memori. \textit {Frozen recognizer} (biru) menunjukkan dominasi jelas di keterbacaan (CER 31.63\% vs 100\%) dan kualitas visual (PSNR 23.09 vs 17.70 dB), sementara \textit {joint training} (merah) menunjukkan kegagalan total di preservasi kemampuan HTR. Efisiensi komputasi sebanding antara kedua pendekatan. Perlu dicatat bahwa data ini berasal dari ablasi 20 \textit {epoch}, sehingga metrik visual belum optimal dibanding \textit {production training}.\relax }{figure.caption.14}{}}
