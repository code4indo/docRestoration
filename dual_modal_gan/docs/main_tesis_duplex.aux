\newlabel{lampiran:A}{{VI.3.2}{171}{Saran untuk Implementasi Praktis}{Item.539}{}}
\newlabel{tab:A_generator_arch}{{A.1}{171}{Arsitektur Generator U-Net Enhanced. Spesifikasi detail lima tahap encoder (progressive downsampling dari $128 \times 1024$ ke $4 \times 32$), bottleneck MSFP dengan konvolusi terdilasi, dan lima tahap decoder dengan attention gates. Setiap tahap mengintegrasikan RDB+CBAM untuk ekstraksi fitur hierarkis dan atensi adaptif. Total parameter: 21,8M; \textit {memory footprint}: $\sim $87~MB (\textit {float32}); aktivasi keluaran: \textit {Tanh} (rentang [-1, 1]).\relax }{table.caption.77}{}}
\newlabel{lampiran:B}{{VI.3.2}{172}{Saran untuk Implementasi Praktis}{table.caption.77}{}}
\newlabel{tab:B_discriminator_arch}{{B.1}{172}{Arsitektur Diskriminator Dual-Modal Enhanced. Spesifikasi detail tiga cabang (Citra CNN, Teks BiLSTM, Fusi \textit {Cross-Modal}). Cabang citra memproses fitur visual melalui 4 \textit {DownBlocks} dengan \textit {spatial attention}, cabang teks memproses sekuens karakter melalui embedding + BiLSTM + \textit {self-attention}. \textit {Cross-modal fusion} menghasilkan klasifikasi \textit {real}/\textit {fake}. Total: 17.4M parameter.\relax }{table.caption.78}{}}
