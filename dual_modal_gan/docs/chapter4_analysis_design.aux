\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Arsitektur Diskriminator Dual-Modal Enhanced. Spesifikasi detail tiga cabang (Citra CNN, Teks BiLSTM, Fusi \textit  {Cross-Modal}). Cabang citra memproses fitur visual melalui 4 \textit  {DownBlocks} dengan \textit  {spatial attention}, cabang teks memproses sekuens karakter melalui embedding + BiLSTM + \textit  {self-attention}. \textit  {Cross-modal fusion} menghasilkan klasifikasi \textit  {real}/\textit  {fake}. Total: 17.4M parameter.\relax }}{89}{table.caption.6}\protected@file@percent }
\newlabel{tab:discriminator_arch}{{4}{89}{Arsitektur Diskriminator Dual-Modal Enhanced. Spesifikasi detail tiga cabang (Citra CNN, Teks BiLSTM, Fusi \textit {Cross-Modal}). Cabang citra memproses fitur visual melalui 4 \textit {DownBlocks} dengan \textit {spatial attention}, cabang teks memproses sekuens karakter melalui embedding + BiLSTM + \textit {self-attention}. \textit {Cross-modal fusion} menghasilkan klasifikasi \textit {real}/\textit {fake}. Total: 17.4M parameter.\relax }{table.caption.6}{}}
\citation{isola2017}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Arsitektur Diskriminator Dual-Modal Enhanced. Visualisasi dua cabang pemrosesan paralel dengan fusi cross-modal bilateral. Cabang CNN (4 DownBlocks + spatial attention) menghasilkan representasi visual 512-D, cabang BiLSTM (embedding + self-attention) menghasilkan representasi tekstual 512-D. Mekanisme bilateral cross-modal attention (Img$\leftrightarrow $Text) memungkinkan interaksi dua arah untuk validasi holistik koherensi visual-tekstual, menghasilkan klasifikasi real/fake pada lapisan fusi 128-D.\relax }}{90}{figure.caption.7}\protected@file@percent }
