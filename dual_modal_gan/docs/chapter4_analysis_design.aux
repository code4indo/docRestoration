\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Konfigurasi bobot loss optimal. Bobot dipilih berdasarkan prinsip \textit  {inverse scaling} empiris (w$_i$ $\propto $ 1/magnitude$_i$) dari analisis distribusi loss, kemudian divalidasi melalui pencarian kisi \textit  {post-hoc} (27 konfigurasi) yang mengonfirmasi konfigurasi ini optimal pada validation set. Bobot pixel L1 yang tinggi ($\lambda =50$) memastikan kesetiaan rekonstruksi dasar, bobot CTC yang relatif rendah ($\lambda =0.15$) dikompensasi oleh magnitudo natural loss CTC ($\sim $100--300) dibandingkan loss L1 ($\sim $0.1--0.5). Validasi grid search menunjukkan tidak ada konfigurasi alternatif yang memberikan peningkatan signifikan pada fase awal training (3 epoch).\relax }}{96}{table.caption.8}\protected@file@percent }
\newlabel{table:optimal_weights}{{5}{96}{Konfigurasi bobot loss optimal. Bobot dipilih berdasarkan prinsip \textit {inverse scaling} empiris (w$_i$ $\propto $ 1/magnitude$_i$) dari analisis distribusi loss, kemudian divalidasi melalui pencarian kisi \textit {post-hoc} (27 konfigurasi) yang mengonfirmasi konfigurasi ini optimal pada validation set. Bobot pixel L1 yang tinggi ($\lambda =50$) memastikan kesetiaan rekonstruksi dasar, bobot CTC yang relatif rendah ($\lambda =0.15$) dikompensasi oleh magnitudo natural loss CTC ($\sim $100--300) dibandingkan loss L1 ($\sim $0.1--0.5). Validasi grid search menunjukkan tidak ada konfigurasi alternatif yang memberikan peningkatan signifikan pada fase awal training (3 epoch).\relax }{table.caption.8}{}}
