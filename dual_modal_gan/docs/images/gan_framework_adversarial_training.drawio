        <mxCell id="objective-box" value="Training Objectives:&#xa;&#xa;Generator:&#xa;minimize: log(1 - D(G(z)))&#xa;&#xa;Discriminator:&#xa;maximize:&#xa;• log(D(x))&#xa;• log(1 - D(G(z)))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
