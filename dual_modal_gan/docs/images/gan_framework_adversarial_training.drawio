        <!-- Mathematical Formulation Box -->
        <mxCell id="math-box" value="Value Function V(D,G):&#xa;&#xa;min_G max_D V(D,G) = &#xa;E[log D(x)] + E[log(1 - D(G(z)))]&#xa;&#xa;Where:&#xa;• G tries to minimize V&#xa;• D tries to maximize V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
