          <mxGeometry x="300" y="560" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="process-steps" value="1. Generator produces fake samples from random noise&#xa;2. Discriminator evaluates real and fake samples&#xa;3. Generator updates to fool discriminator&#xa;4. Discriminator updates to distinguish real from fake&#xa;5. Process repeats until Nash equilibrium" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#0099cc;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
