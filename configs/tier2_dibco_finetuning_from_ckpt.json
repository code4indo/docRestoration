{
  "experiment_name": "tier2_dibco_finetuning_improved",
  "description": "TIER 2 IMPLEMENTATION: Fine-tuning DIBCO visual-only model (run a6a86fd6) with IMPROVED CONFIG - LR scheduling + larger batch + stability improvements. Resume from epoch 49 checkpoint (22.85 dB PSNR). Target: 24-26 dB PSNR (+2-3 dB from baseline).",
  
  "generator_version": "enhanced",
  "discriminator_version": "enhanced_v2_fixed",

  "tfrecord_path": "dual_modal_gan/data/dibco_tiled_no_palm.tfrecord",
  "checkpoint_dir": "dual_modal_gan/checkpoints/tier2_dibco_finetuning_improved",
  "sample_dir": "dual_modal_gan/outputs/samples_tier2_dibco_finetuning_improved",

  "resume": true,

  "epochs": 80,
  "batch_size": 4,
  "steps_per_epoch": 0,
  "save_interval": 3,
  "eval_interval": 1,
  "seed": 42,
  "max_checkpoints": 5,
  "gpu_id": "0,1",

  "checkpoints": {
