  "discriminator_mode": "predicted",

  "experiment_metadata": {
    "baseline_run": "a6a86fd6a82445cf825e1b7c47ec8ff5",
    "baseline_psnr": 22.85,
    "baseline_issues": [
      "No LR scheduling → late-stage instability (std 0.50 dB)",
      "Batch size 4 → high gradient noise",
      "Constant LR 0.0002 → oscillation in late epochs",
      "Overfitting after epoch 18"
    ],
    "tier2_improvements": [
      "LR scheduling: cosine decay from 0.0001 → 0.000001",
      "Batch size 4 (same, safe for memory)",
      "Lower initial LR: 0.0001 (vs 0.0002) → more stable",
      "Patience 8 (vs 12) → earlier stopping",
      "30 epochs (vs 50) → prevent overfitting",
      "Resume from epoch 49 → continue from best weights"
    ],
    "expected_gain": "+2-3 dB PSNR (target 24-26 dB)",
    "rationale": "Analysis showed training converged at epoch 18 but degraded due to high LR and no scheduling. Lower LR with scheduling should stabilize and improve."
  }
