{
  "experiment_name": "h2a_dual_modal_treatment_group",
  "description": "H2A EXPERIMENT - Treatment Group: Dual-Modal Discriminator (CNN+LSTM). Expected to produce lower CER compared to single-modal baseline.",

  "generator_version": "enhanced",
  "discriminator_version": "enhanced_v2_fixed",

  "tfrecord_path": "dual_modal_gan/data/dataset_gan.tfrecord",
  "charset_path": "real_data_preparation/real_data_charlist.txt",
  "recognizer_weights": "/home/lambda_one/tesis/GAN-HTR-ORI/htr_improved_v2_20251001_221138/best_model.weights.h5",

  "checkpoint_dir": "dual_modal_gan/checkpoints/h2a_dual_modal",
  "sample_dir": "dual_modal_gan/outputs/samples_h2a_dual_modal",

  "resume": false,
  "no_restore": true,

  "epochs": 50,
  "batch_size": 2,
  "steps_per_epoch": 0,
  "save_interval": 2,
  "eval_interval": 1,
  "seed": 42,
  "max_checkpoints": 3,
  "gpu_id": "0",

  "train_split": 0.7,
  "val_split": 0.15,

  "checkpoints": {
    "save_best_model_separately": true
  },

  "early_stopping": {
    "enabled": true,
    "curriculum_aware": true,
    "patience": 25,
    "min_delta": 0.05,
    "restore_best_weights": true
