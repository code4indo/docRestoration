{
  "experiment_name": "production_v4_gradnorm_adaptive",
  "description": "PRODUCTION TRAINING - GradNorm adaptive loss balancing. Full training (50 epochs) with automatic loss weight optimization for Q1 journal publication. Novelty: First application of GradNorm to GAN-HTR document restoration.",

  "generator_version": "enhanced",
  "discriminator_version": "enhanced_v2_fixed",

  "tfrecord_path": "dual_modal_gan/data/dataset_gan.tfrecord",
  "charset_path": "real_data_preparation/real_data_charlist.txt",
  "recognizer_weights": "/home/lambda_one/tesis/GAN-HTR-ORI/htr_improved_v2_20251001_221138/best_model.weights.h5",
  "checkpoint_dir": "dual_modal_gan/checkpoints/production_v4_gradnorm",
  "sample_dir": "dual_modal_gan/outputs/samples_production_v4_gradnorm",

  "resume": false,
  "no_restore": true,

  "epochs": 50,
  "batch_size": 2,
  "steps_per_epoch": 50,
  "save_interval": 2,
  "eval_interval": 1,
  "seed": 42,
  "max_checkpoints": 5,
  "gpu_id": "0",

  "train_split": 0.7,
  "val_split": 0.15,

  "checkpoints": {
    "save_best_model_separately": true
  },

  "early_stopping": {
    "enabled": true,
    "curriculum_aware": false,
    "patience": 25,
    "min_delta": 0.05,
    "restore_best_weights": true
  },

  "early_stopping_metric": "combined",
  "psnr_improvement_threshold": 2.0,
  "cer_weight": 0.2,

  "lr_g": 0.0002,
  "lr_d": 0.0002,
  "use_lr_schedule": false,
  "warmup_epochs": 0,
  "annealing_epochs": 0,

  "use_gradnorm": true,
  "gradnorm_config": {
    "alpha": 1.5,
    "update_frequency": 1,
    "loss_names": ["pixel", "adversarial", "rec_feat", "perceptual", "ctc"],
    "initial_weights": [50.0, 3.0, 8.0, 1.0, 0.15],
    "comment": "alpha=1.5 provides strong adaptation. Initial weights from production_v3 baseline."
  },

  "pixel_loss_weight": 50.0,
  "adv_loss_weight": 3.0,
  "rec_feat_loss_weight": 8.0,
  "ctc_loss_weight": 0.15,
  "perceptual_loss_weight": 1.0,
  "gradient_clip_norm": 1.0,
  "ctc_loss_clip_max": 400.0,

  "discriminator_mode": "predicted",

  "adaptive_loss_balancing": false,
  "target_ctc_ratio": 0.40,
  "target_visual_ratio": 0.60,
  "adaptation_rate": 0.08,

  "discriminator_config": {
    "spatial_attention_kernel": 3,
    "cross_modal_common_dim": 128,
    "batchnorm_momentum": 0.9,
    "dropout_rate": 0.1,
    "use_residual_blocks": true,
    "use_spatial_attention": true,
    "use_cross_modal_attention": true,
    "attention_type": "scaled_dot_product"
  }
}
