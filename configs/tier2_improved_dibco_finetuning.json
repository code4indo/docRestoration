{
  "experiment_name": "tier2_improved_dibco_finetuning",
  "description": "TIER 2 IMPROVEMENT - Fine-tuning on DIBCO with optimal hyperparameters: batch_size=8, LR scheduling with cosine annealing + warmup, SSIM loss component, improved early stopping. Target: +2-3 dB improvement over baseline (22.99 dB → 24-25 dB).",

  "generator_version": "enhanced",
  "discriminator_version": "enhanced_v2_fixed",

  "tfrecord_path": "dual_modal_gan/data/dibco_tiled_no_palm.tfrecord",
