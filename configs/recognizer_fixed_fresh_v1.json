{
  "experiment_name": "recognizer_fixed_fresh_v1",
  "description": "FRESH TRAINING with fixed recognizer (8192->512 projection fix). Clean slate test to validate recognizer shape mismatch resolution. Expected: CER improvement from ~1.4 (random) to ~0.3-0.4 (meaningful), stable training without shape errors, PSNR > 23 dB, text readability preserved.",

  "generator_version": "enhanced",
  "discriminator_version": "enhanced_v2_fixed",

  "tfrecord_path": "dual_modal_gan/data/dataset_gan.tfrecord",
  "charset_path": "real_data_preparation/real_data_charlist.txt",
  "recognizer_weights": "models/best_htr_recognizer/best_model.weights.h5",
  "checkpoint_dir": "dual_modal_gan/checkpoints/recognizer_fixed_fresh_v1",
  "sample_dir": "dual_modal_gan/outputs/samples_recognizer_fixed_fresh_v1",

  "resume": false,
  "no_restore": true,

  "epochs": 60,
  "batch_size": 2,
  "steps_per_epoch": 100,
  "save_interval": 1,
  "eval_interval": 1,
  "seed": 42,
  "max_checkpoints": 1,
  "gpu_id": "0",

  "checkpoints": {
    "save_best_model_separately": true
  },

  "early_stopping": {
    "enabled": true,
    "curriculum_aware": true,
    "patience": 15,
    "min_delta": 0.01,
    "restore_best_weights": true
  },

  "early_stopping_metric": "combined",
  "psnr_improvement_threshold": 2.0,
  "cer_weight": 0.2,

  "lr_g": 0.0001,
  "lr_d": 0.0001,
  "use_lr_schedule": true,
  "warmup_epochs": 15,
  "annealing_epochs": 25,

  "pixel_loss_weight": 50.0,
  "adv_loss_weight": 3.0,
  "rec_feat_loss_weight": 8.0,
  "ctc_loss_weight": 0.15,
  "perceptual_loss_weight": 1.0,
  "gradient_clip_norm": 1.0,
  "ctc_loss_clip_max": 400.0,

  "discriminator_mode": "predicted",

  "adaptive_loss_balancing": true,
  "target_ctc_ratio": 0.40,
  "target_visual_ratio": 0.60,
  "adaptation_rate": 0.08,

  "discriminator_config": {
    "spatial_attention_kernel": 3,
    "cross_modal_common_dim": 128,
    "batchnorm_momentum": 0.9,
    "dropout_rate": 0.1,
    "use_residual_blocks": true,
    "use_spatial_attention": true,
    "use_cross_modal_attention": true,
    "attention_type": "scaled_dot_product"
  }
}