# Loghi Services Environment Configuration
# Generated for GAN-HTR-ORI Integration

# User configuration
MY_UID=1000
MY_GID=1000

# Model paths (absolute paths)
LAYPA_MODEL_PATH=/home/lambda_one/tesis/loghi/models/general/baseline
LOGHI_MODEL_PATH=/home/lambda_one/tesis/loghi/models/generic-2023-02-15

# Tooling configuration file
TOOLING_CONFIG_FILE=/home/lambda_one/tesis/loghi/webservice/loghi-tooling/configuration.yml

# Output directories (will be created automatically)
LAYPA_OUTPUT_PATH=/home/lambda_one/tesis/loghi/laypa_output
LOGHI_OUTPUT_PATH=/home/lambda_one/tesis/loghi/loghi_output
TOOLING_OUTPUT_PATH=/home/lambda_one/tesis/loghi/tooling_output

# GPU Configuration
# LAYPA_GPU_COUNT=0 : Use CPU for LAYPA (recommended if single GPU)
# HTR_GPU_COUNT=1 : Use GPU for HTR (critical for performance)
LAYPA_GPU_COUNT=0
HTR_GPU_COUNT=1

# Gradio Configuration (if using Loghi's Gradio - we'll use our own)
GRADIO_QUEUE_SIZE=10
GRADIO_WORKERS=1
