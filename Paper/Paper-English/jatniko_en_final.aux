\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Visual comparison of restoration methods on 5 representative test set samples. Rows show: (1) degraded input image, (2) Otsu result, (3) Sauvola result, (4) proposed method result, (5) clean ground truth. Proposed method produces high visual quality (PSNR 30.74\nobreakspace  {}dB, SSIM 0.987) and higher HTR accuracy (CER 34.9\%) compared to classical methods that produce binarization artifacts.\relax }}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:method_comparison}{{7}{16}{Visual comparison of restoration methods on 5 representative test set samples. Rows show: (1) degraded input image, (2) Otsu result, (3) Sauvola result, (4) proposed method result, (5) clean ground truth. Proposed method produces high visual quality (PSNR 30.74~dB, SSIM 0.987) and higher HTR accuracy (CER 34.9\%) compared to classical methods that produce binarization artifacts.\relax }{figure.caption.13}{}}
