\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Degradation level correlation analysis on validation set (n=710): (a) strong negative correlation (Pearson r=--0.963, p<0.001) between SNR and CER improvement shows restoration more effective on heavily degraded documents, (b) PSNR vs post-restoration CER shows model brings all degradation levels close to clean image reference value (26.6\%, green line), (c) SSIM vs CER shows weak correlation indicating structural similarity not sole predictor for HTR accuracy, (d) before-after CER comparison shows majority of samples experience improvement (points below diagonal y=x, gray). Note: Data from validation set (n=710) with statistics PSNR 30.91±5.60 dB, CER 27.11±20.83\%, SSIM 0.987±0.014. Final evaluation on test set (n=712) reported in Table\nobreakspace  {}\ref  {table_synthetic_results}: PSNR 30.74 dB, CER 34.9\%, SSIM 0.987.\relax }}{20}{figure.caption.18}\protected@file@percent }
\newlabel{fig:degradation_correlation}{{10}{20}{Degradation level correlation analysis on validation set (n=710): (a) strong negative correlation (Pearson r=--0.963, p<0.001) between SNR and CER improvement shows restoration more effective on heavily degraded documents, (b) PSNR vs post-restoration CER shows model brings all degradation levels close to clean image reference value (26.6\%, green line), (c) SSIM vs CER shows weak correlation indicating structural similarity not sole predictor for HTR accuracy, (d) before-after CER comparison shows majority of samples experience improvement (points below diagonal y=x, gray). Note: Data from validation set (n=710) with statistics PSNR 30.91±5.60 dB, CER 27.11±20.83\%, SSIM 0.987±0.014. Final evaluation on test set (n=712) reported in Table~\ref {table_synthetic_results}: PSNR 30.74 dB, CER 34.9\%, SSIM 0.987.\relax }{figure.caption.18}{}}
