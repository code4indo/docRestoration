\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Perbandingan visual metode restorasi pada 5 sampel representatif dari set uji. Baris menunjukkan: (1) citra terdegradasi masukan, (2) hasil Otsu, (3) hasil Sauvola, (4) hasil metode usulan, (5) \textit  {ground truth} bersih. Metode usulan menghasilkan kualitas visual tinggi (PSNR 30.74\nobreakspace  {}dB, SSIM 0.987) dan akurasi HTR lebih tinggi (CER 34.9\%) dibanding metode klasik yang menghasilkan artefak binarisasi.\relax }}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:method_comparison}{{7}{16}{Perbandingan visual metode restorasi pada 5 sampel representatif dari set uji. Baris menunjukkan: (1) citra terdegradasi masukan, (2) hasil Otsu, (3) hasil Sauvola, (4) hasil metode usulan, (5) \textit {ground truth} bersih. Metode usulan menghasilkan kualitas visual tinggi (PSNR 30.74~dB, SSIM 0.987) dan akurasi HTR lebih tinggi (CER 34.9\%) dibanding metode klasik yang menghasilkan artefak binarisasi.\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Trajektori metrik validasi dengan interval kepercayaan 95\% selama 50 \textit  {epoch} (n=710): (a) PSNR mencapai 30.91±0.42\nobreakspace  {}dB, (b) SSIM mencapai 0.987±0.001, (c,d) CER dan WER mendekati \textit  {baseline} citra bersih. Model terbaik (\textit  {epoch} 44, bintang merah) dipilih berdasarkan kriteria gabungan PSNR-CER. Interval kepercayaan sempit mengindikasikan kinerja konsisten. Evaluasi akhir pada set uji: PSNR 30.74\nobreakspace  {}dB, SSIM 0.987, CER 34.9\% (Tabel\nobreakspace  {}\ref  {table_synthetic_results}).\relax }}{17}{figure.caption.14}\protected@file@percent }
\newlabel{fig:validation_metrics}{{8}{17}{Trajektori metrik validasi dengan interval kepercayaan 95\% selama 50 \textit {epoch} (n=710): (a) PSNR mencapai 30.91±0.42~dB, (b) SSIM mencapai 0.987±0.001, (c,d) CER dan WER mendekati \textit {baseline} citra bersih. Model terbaik (\textit {epoch} 44, bintang merah) dipilih berdasarkan kriteria gabungan PSNR-CER. Interval kepercayaan sempit mengindikasikan kinerja konsisten. Evaluasi akhir pada set uji: PSNR 30.74~dB, SSIM 0.987, CER 34.9\% (Tabel~\ref {table_synthetic_results}).\relax }{figure.caption.14}{}}
