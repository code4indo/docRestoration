\@writefile{lot}{\contentsline {table}{\numberline {XI}{\ignorespaces Studi Ablasi Inkremental Komponen Kehilangan: kontribusi setiap komponen kehilangan terhadap kualitas restorasi dokumen. Lima konfigurasi eksperimen dengan penambahan inkremental komponen: (1) \textit  {baseline} kehilangan piksel (L1), (2) penambahan kehilangan \textit  {adversarial}, (3) penambahan kehilangan perseptual (VGG-19), (4) penambahan kehilangan CTC untuk kesadaran HTR, (5) penambahan kehilangan fitur pengenal. Setiap eksperimen dilatih selama 15 \textit  {epoch} dengan \textit  {hyperparameter} identik untuk mengisolasi dampak individual setiap komponen. Metrik evaluasi mencakup PSNR (kualitas piksel), SSIM (kesamaan struktural), dan CER (kinerja HTR) pada \textit  {set} validasi ($n$=710 citra).\relax }}{24}{table.caption.21}\protected@file@percent }
\newlabel{table_ablation_loss}{{XI}{24}{Studi Ablasi Inkremental Komponen Kehilangan: kontribusi setiap komponen kehilangan terhadap kualitas restorasi dokumen. Lima konfigurasi eksperimen dengan penambahan inkremental komponen: (1) \textit {baseline} kehilangan piksel (L1), (2) penambahan kehilangan \textit {adversarial}, (3) penambahan kehilangan perseptual (VGG-19), (4) penambahan kehilangan CTC untuk kesadaran HTR, (5) penambahan kehilangan fitur pengenal. Setiap eksperimen dilatih selama 15 \textit {epoch} dengan \textit {hyperparameter} identik untuk mengisolasi dampak individual setiap komponen. Metrik evaluasi mencakup PSNR (kualitas piksel), SSIM (kesamaan struktural), dan CER (kinerja HTR) pada \textit {set} validasi ($n$=710 citra).\relax }{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Studi ablasi inkremental komponen loss: (a--b) Metrik absolut PSNR dan SSIM untuk setiap konfigurasi, (c--d) Peningkatan inkremental relatif terhadap baseline hanya-piksel. Error bars menunjukkan deviasi standar pada validation set. Loss adversarial memberikan peningkatan PSNR tertinggi (+0.27 dB), sementara loss perceptual mengoptimalkan kesamaan struktural (+0.0016 SSIM).\relax }}{24}{figure.caption.22}\protected@file@percent }
\newlabel{fig:ablation_comparison}{{11}{24}{Studi ablasi inkremental komponen loss: (a--b) Metrik absolut PSNR dan SSIM untuk setiap konfigurasi, (c--d) Peningkatan inkremental relatif terhadap baseline hanya-piksel. Error bars menunjukkan deviasi standar pada validation set. Loss adversarial memberikan peningkatan PSNR tertinggi (+0.27 dB), sementara loss perceptual mengoptimalkan kesamaan struktural (+0.0016 SSIM).\relax }{figure.caption.22}{}}
